pkgname=happwner-pc-bin
pkgver="${HAPPWNER_VERSION:-0.1.6}"
pkgrel=3
pkgdesc="Local and home-network proxy subscription server"
arch=('x86_64')
url="https://github.com/Kasumicic/Happwner_PC"
license=('custom:non-commercial')
depends=('glibc' 'gcc-libs' 'libx11' 'libglvnd' 'fontconfig' 'freetype2' 'alsa-lib' 'hicolor-icon-theme')
optdepends=('gnome-shell-extension-appindicator: tray integration on GNOME')
provides=('happwner-pc')
conflicts=('happwner-pc')
options=('!strip' '!debug')
source=(
  "happwner-pc-${pkgver}-linux-x86_64.tar.gz"
  'happwner-pc.desktop'
  'happwner-pc-48.png'
  'happwner-pc-64.png'
  'happwner-pc-128.png'
  'happwner-pc-256.png'
  'happwner-pc-512.png'
  'TERMS'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -d "$pkgdir/opt/happwner-pc"
  cp -a "$srcdir/Happwner PC/." "$pkgdir/opt/happwner-pc/"

  install -d "$pkgdir/usr/bin"
  ln -s "/opt/happwner-pc/bin/Happwner PC" "$pkgdir/usr/bin/happwner-pc"

  install -Dm644 "$srcdir/happwner-pc.desktop" \
    "$pkgdir/usr/share/applications/happwner-pc.desktop"
  local size
  for size in 48 64 128 256 512; do
    install -Dm644 "$srcdir/happwner-pc-${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/happwner-pc.png"
  done
  install -Dm644 "$srcdir/happwner-pc-256.png" \
    "$pkgdir/usr/share/pixmaps/happwner-pc.png"
  install -Dm644 "$srcdir/TERMS" \
    "$pkgdir/usr/share/licenses/$pkgname/TERMS"
}
